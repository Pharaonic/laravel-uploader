{
    "name": "pharaonic/laravel-uploader",
    "description": "Upload files to any Laravel disk with hashed names, image thumbnails, visibility control and secure URLs.",
    "keywords": [
        "php",
        "laravel",
        "uploader",
        "file upload",
        "uploads",
        "thumbnail",
        "visibility",
        "temporary url",
        "pharaonic"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Moamen Eltouny (Raggi)",
            "email": "raggigroup@gmail.com"
        }
    ],
    "support": {
        "docs": "https://pharaonic.dev/packages/laravel/uploader",
        "issues": "https://github.com/Pharaonic/laravel-uploader/issues",
        "source": "https://github.com/Pharaonic/laravel-uploader"
    },
    "require": {
        "php": ">=8.0 <8.2",
        "illuminate/contracts": "^8.75",
        "illuminate/database": "^8.75",
        "illuminate/filesystem": "^8.75",
        "illuminate/http": "^8.75",
        "illuminate/routing": "^8.75",
        "illuminate/support": "^8.75",
        "intervention/image": "^2.7",
        "pharaonic/laravel-readable": "^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.5",
        "orchestra/testbench": "^6.25",
        "pestphp/pest": "^1.23",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6.33"
    },
    "suggest": {
        "ext-gd": "Required by Intervention Image to generate thumbnails, unless ext-imagick is configured.",
        "league/flysystem-aws-s3-v3": "Required to store uploads on S3 with visibility and temporary URLs."
    },
    "autoload": {
        "psr-4": {
            "Pharaonic\\Laravel\\Uploader\\": "src/"
        },
        "files": [
            "src/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pharaonic\\Laravel\\Uploader\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pharaonic\\Laravel\\Uploader\\UploaderServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "@php vendor/bin/pint",
        "format:check": "@php vendor/bin/pint --test",
        "security": "@composer audit",
        "check": [
            "@composer validate --strict",
            "@format:check",
            "@analyse",
            "@test",
            "@security"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "abandoned": "report"
        },
        "policy": {
            "advisories": {
                "block": false,
                "ignore": {
                    "laravel/framework": "No fixed release within Laravel 8; the application chooses the framework release.",
                    "league/flysystem": "No fixed release within Laravel 8; the application chooses the framework release."
                }
            }
        },
        "sort-packages": true
    },
    "prefer-stable": true
}
